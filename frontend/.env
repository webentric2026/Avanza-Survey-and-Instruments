# Avanza — Contact SMTP
# Copy to .env and fill with real values. Never commit .env with secrets.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 587 = STARTTLS (recommended), 465 = SSL
SMTP_SECURE=false
SMTP_USER=apikey_or_smtp_user
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM="Avanza Website <noreply@avanza.example>"
CONTACT_EMAIL=contact@avanza.example

# Optional — rate limiting (in-memory; use Redis/KV for multi-instance)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
